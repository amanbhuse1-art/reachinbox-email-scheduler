generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxEventType {
  EMAIL_SCHEDULED
  EMAIL_STATUS_UPDATED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?

  ownedTenants Tenant[] @relation("TenantOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id          String @id @default(uuid())
  name        String
  ownerUserId String

  owner User @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  senderAccounts  SenderAccount[]
  campaigns       Campaign[]
  emailMessages   EmailMessage[]
  slackConnection SlackConnection?
  idempotencyKeys IdempotencyKey[]
  outboxEvents    OutboxEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

model SenderAccount {
  id       String @id @default(uuid())
  tenantId String

  name  String
  email String

  smtpHost              String
  smtpPort              Int
  smtpUsername          String
  smtpPasswordEncrypted String
  smtpSecure            Boolean @default(true)

  enabled          Boolean @default(true)
  maxEmailsPerHour Int     @default(200)
  minDelayMs       Int     @default(2000)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  emailMessages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, enabled])
}

model Campaign {
  id       String @id @default(uuid())
  tenantId String
  senderId String

  name        String
  subject     String
  body        String
  startAt     DateTime
  delayMs     Int
  hourlyLimit Int
  totalEmails Int

  status CampaignStatus @default(SCHEDULED)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender        SenderAccount  @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emailMessages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model EmailMessage {
  id String @id @default(uuid())

  campaignId String
  tenantId   String
  senderId   String

  recipient String
  subject   String
  body      String

  sequenceNumber Int

  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?

  status EmailStatus @default(SCHEDULED)

  attempts          Int     @default(0)
  lastError         String?
  bullJobId         String?
  idempotencyKey    String  @unique
  providerMessageId String? @unique

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender   SenderAccount @relation(fields: [senderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, sentAt])
  @@index([senderId, status])
  @@index([campaignId, sequenceNumber])
  @@index([recipient])
}

model SlackConnection {
  id       String @id @default(uuid())
  tenantId String @unique

  teamId   String
  teamName String

  webhookUrlEncrypted String

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id          String @id @default(uuid())
  tenantId    String
  key         String
  requestHash String
  campaignId  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
}

model OutboxEvent {
  id          String @id @default(uuid())
  tenantId    String
  eventType   OutboxEventType
  aggregateId String

  payload Json

  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  processedAt DateTime?
  lastError   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([tenantId, status])
}